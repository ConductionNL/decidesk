	"pages": [
		{
			"id": "MeetingTypes",
			"route": "/meeting-types",
			"type": "index",
			"title": "Meeting types",
			"_note": "Every kind of meeting a body holds. Draft is a real state here: a type that is still a draft cannot back a new meeting, so an operator can prepare one without it appearing in every picker.",
			"config": {
				"register": "decidiq",
				"schema": "meeting-type",
				"sortKey": "name",
				"sortOrder": "asc",
				"quickFilterMode": "dropdown",
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "In use",
						"filter": {
							"active": true
						}
					},
					{
						"label": "Draft",
						"filter": {
							"isDraft": true
						}
					}
				],
				"columns": [
					{
						"key": "name",
						"label": "Name",
						"widget": "link"
					},
					{
						"key": "governanceBody",
						"label": "Body"
					},
					{
						"key": "defaultDurationMinutes",
						"label": "Duration (min)"
					},
					{
						"key": "isPublic",
						"label": "Public",
						"widget": "boolean"
					},
					{
						"key": "active",
						"label": "In use",
						"widget": "boolean"
					}
				],
				"rowRoute": "MeetingTypeDetail",
				"allowCreate": true,
				"emptyText": "No meeting types configured yet. An example set seeds some, or add your own."
			}
		},
		{
			"id": "MeetingTypeDetail",
			"route": "/meeting-types/:id",
			"type": "detail",
			"title": "Meeting type",
			"config": {
				"register": "decidiq",
				"schema": "meeting-type",
				"widgets": [
					{
						"id": "meeting-type-data",
						"type": "data",
						"title": "Meeting type",
						"icon": "CalendarTextOutline",
						"content": {
							"columns": 2
						}
					},
					{
						"id": "meeting-type-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "meeting-type-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 7
					},
					{
						"id": "2",
						"widgetId": "meeting-type-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 7
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "AgendaItemTypes",
			"route": "/agenda-item-types",
			"type": "index",
			"title": "Agenda item types",
			"_note": "The kinds an agenda item can be. Since questions-as-agenda-items this is where an organisation says what it calls an oral question, what fields one carries, how long before the meeting it may be submitted, and whether it needs support before it is admitted.",
			"config": {
				"register": "decidiq",
				"schema": "agenda-item-type",
				"sortKey": "order",
				"sortOrder": "asc",
				"quickFilterMode": "dropdown",
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "In use",
						"filter": {
							"active": true
						}
					},
					{
						"label": "Draft",
						"filter": {
							"isDraft": true
						}
					},
					{
						"label": "Votable",
						"filter": {
							"votable": true
						}
					}
				],
				"columns": [
					{
						"key": "name",
						"label": "Name",
						"widget": "link"
					},
					{
						"key": "owningBody",
						"label": "Owning body"
					},
					{
						"key": "votable",
						"label": "Votable",
						"widget": "boolean"
					},
					{
						"key": "submissionWindowHours",
						"label": "Submission window (hours)"
					},
					{
						"key": "active",
						"label": "In use",
						"widget": "boolean"
					}
				],
				"rowRoute": "AgendaItemTypeDetail",
				"allowCreate": true,
				"emptyText": "No agenda item types configured yet. An example set seeds some, or add your own."
			}
		},
		{
			"id": "AgendaItemTypeDetail",
			"route": "/agenda-item-types/:id",
			"type": "detail",
			"title": "Agenda item type",
			"config": {
				"register": "decidiq",
				"schema": "agenda-item-type",
				"widgets": [
					{
						"id": "agenda-item-type-data",
						"type": "data",
						"title": "Agenda item type",
						"icon": "FormatListNumbered",
						"content": {
							"columns": 2
						}
					},
					{
						"id": "agenda-item-type-items",
						"type": "object-list",
						"title": "Items of this kind",
						"icon": "FormatListBulleted",
						"content": {
							"register": "decidiq",
							"schema": "agenda-item",
							"filter": {
								"type": "@objectId"
							},
							"sort": {
								"field": "orderNumber",
								"dir": "asc"
							},
							"columns": [
								{
									"key": "title",
									"label": "Title",
									"widget": "link"
								},
								{
									"key": "meeting",
									"label": "Meeting"
								},
								{
									"key": "orderNumber",
									"label": "#"
								}
							],
							"limit": 25,
							"allowCreate": false,
							"emptyText": "No agenda items use this kind yet."
						}
					},
					{
						"id": "agenda-item-type-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "agenda-item-type-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 7
					},
					{
						"id": "2",
						"widgetId": "agenda-item-type-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 7
					},
					{
						"id": "3",
						"widgetId": "agenda-item-type-items",
						"gridX": 0,
						"gridY": 7,
						"gridWidth": 12,
						"gridHeight": 6
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
