{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Commitments (formerly toezeggingen) — appended onto the bundled src/manifest.json by main.js::mergeManifestFragments (ADR-037). Index + detail; schema ref BY SLUG (governance-commitment), never the PascalCase key. The ingekomen-stukken surfaces this fragment used to carry were removed by documents-as-agenda-items: incoming correspondence is an agenda item carrying a configurable kind, so it appears in the agenda rather than in a register of its own. The Dashboard overdue-commitments stat widget lives in the base src/manifest.json, because mergePages replaces a same-id page wholesale and a fragment cannot add one widget to Dashboard without redefining it.",
	"_spec": "openspec/changes/toezeggingen-ingekomen-stukken/specs/toezeggingen-register/spec.md",
	"menu": [
		{
			"id": "Commitments",
			"label": "Commitments",
			"icon": "Check",
			"route": "Commitments",
			"order": 45
		}
	],
	"pages": [
		{
			"id": "Commitments",
			"route": "/commitments",
			"type": "index",
			"title": "Commitments",
			"_note": "spec: openspec/changes/toezeggingen-ingekomen-stukken/specs/toezeggingen-register/spec.md",
			"config": {
				"register": "decidiq",
				"schema": "governance-commitment",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Toezeggingenlijst (REQ-006). Columns text/madeBy/directedTo/deadline/lifecycle; quick filters on lifecycle and governance body. CSV export via the shared ExportService + CnMassExportDialog (mass-export exposed by the index chrome). The overdue-KPI deep-link (Dashboard) targets this page pre-filtered to non-terminal lifecycle (design D6).",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "Open",
						"filter": {
							"lifecycle": "open"
						}
					},
					{
						"label": "In progress",
						"filter": {
							"lifecycle": "in-execution"
						}
					},
					{
						"label": "Settled",
						"filter": {
							"lifecycle": "disposed"
						}
					},
					{
						"label": "Lapsed",
						"filter": {
							"lifecycle": "lapsed"
						}
					}
				],
				"columns": [
					{
						"key": "text",
						"label": "Commitment",
						"widget": "link"
					},
					{
						"key": "madeBy",
						"label": "Made by",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "decidiq",
							"schema": "person",
							"labelField": "name"
						}
					},
					{
						"key": "directedTo",
						"label": "Directed to",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "decidiq",
							"schema": "governance-body",
							"labelField": "name"
						}
					},
					{
						"key": "deadline",
						"label": "Deadline"
					},
					{
						"key": "lifecycle",
						"label": "Status",
						"widget": "badge"
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "CommitmentDetail",
						"primary": true
					}
				],
				"showMassExport": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "CommitmentDetail",
			"route": "/commitments/:id",
			"type": "detail",
			"title": "Commitment",
			"_note": "spec: openspec/changes/toezeggingen-ingekomen-stukken/specs/toezeggingen-register/spec.md",
			"config": {
				"register": "decidiq",
				"schema": "governance-commitment",
				"_note": "ToezeggingDetail (REQ-006). Commitment data leads 8-wide, publication + evidence stacked right; the linked meeting/agendaItem/madeBy/directedTo/relatedMotion render as resolved references in the data widget and the Related widget. Files leaf for the raadsbrief/evidence. Audit trail is a sidebar tab (REQ-006). No comms leaf: the toezegging schema declares no email/calendar linkedType.",
				"widgets": [
					{
						"id": "toezegging-data",
						"type": "data",
						"title": "Commitment",
						"icon": "HandshakeOutline",
						"content": {
							"columns": 2
						}
					},
					{
						"id": "toezegging-files",
						"type": "integration",
						"integrationId": "files",
						"title": "Documents",
						"icon": "FolderOutline"
					},
					{
						"id": "toezegging-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "toezegging-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 6
					},
					{
						"id": "2",
						"widgetId": "toezegging-files",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 6
					},
					{
						"id": "3",
						"widgetId": "toezegging-related",
						"gridX": 0,
						"gridY": 6,
						"gridWidth": 12,
						"gridHeight": 3
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		}
	]
}
