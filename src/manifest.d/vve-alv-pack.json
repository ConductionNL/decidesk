{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "VvE ALV statutory pack, now nearly empty by design. The decision-template and modelreglement-preset surfaces went to src/manifest.d/decision-templates.json (unified-decision-templates had superseded both schemas); VveConfiguration became BodyGovernanceConfiguration (generic-body-configuration); KascommissieVerklaring became AuditStatement (generic-audit-statement). What is left is two generic surfaces that happen to have been introduced by this pack. Schema refs BY SLUG, never PascalCase.",
	"_spec": "openspec/changes/vve-alv-pack/specs/vve-alv-pack/spec.md",
	"menu": [
		{
			"id": "BodyConfigurations",
			"label": "Body configuration",
			"icon": "CogOutline",
			"route": "BodyConfigurations",
			"order": 73
		},
		{
			"id": "AuditStatements",
			"label": "Audit statements",
			"icon": "Check",
			"route": "AuditStatements",
			"order": 74
		}
	],
	"pages": [
		{
			"id": "BodyConfigurations",
			"route": "/body-configurations",
			"type": "index",
			"title": "Body configuration",
			"_note": "Per-body governance configuration for ANY organisation: the document that constitutes the body, the regulation version it follows, the denominator its weighted votes are expressed over, and any majority overrides. Replaces the VvE-only surface; generic-body-configuration supersedes VveConfiguration non-destructively.",
			"config": {
				"register": "decidiq",
				"schema": "body-governance-configuration",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Schema ref by slug (body-governance-configuration), never PascalCase.",
				"columns": [
					{
						"key": "governanceBody",
						"label": "Governance body",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "decidiq",
							"schema": "governance-body",
							"labelField": "name"
						}
					},
					{
						"key": "regulationVersion",
						"label": "Regulation version"
					},
					{
						"key": "voteWeightDenominator",
						"label": "Vote weight denominator"
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "BodyConfigurationDetail",
						"primary": true
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "BodyConfigurationDetail",
			"route": "/body-configurations/:id",
			"type": "detail",
			"title": "Body configuration",
			"_note": "Configuration data leads; the referenced body and constitutive document render as resolved references. Audit trail in a sidebar tab.",
			"config": {
				"register": "decidiq",
				"schema": "body-governance-configuration",
				"_note": "Schema ref by slug (body-governance-configuration), never PascalCase.",
				"widgets": [
					{
						"id": "config-data",
						"type": "data",
						"title": "Body configuration",
						"icon": "OfficeBuilding",
						"content": {
							"columns": 2
						}
					},
					{
						"id": "config-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "config-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
						"gridHeight": 6
					},
					{
						"id": "2",
						"widgetId": "config-related",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 6
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "AuditStatements",
			"route": "/audit-statements",
			"type": "index",
			"title": "Audit statements",
			"_note": "Audit statements per financial year, with the verdict and the agenda item where the accounts were adopted. Generic: a kascommissie is one kind of audit committee, and the Dutch label is supplied per organisatie_modus rather than baked into the schema.",
			"config": {
				"register": "decidiq",
				"schema": "audit-statement",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Schema ref by slug (audit-statement), never PascalCase.",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "Approving",
						"filter": {
							"verdict": "approving"
						}
					},
					{
						"label": "With reservation",
						"filter": {
							"verdict": "qualified"
						}
					},
					{
						"label": "Rejecting",
						"filter": {
							"verdict": "adverse"
						}
					}
				],
				"columns": [
					{
						"key": "financialYear",
						"label": "Boekjaar",
						"widget": "link",
						"formatter": "plainYear"
					},
					{
						"key": "verdict",
						"label": "Verdict",
						"widget": "badge"
					},
					{
						"key": "governanceBody",
						"label": "Governance body",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "decidiq",
							"schema": "governance-body",
							"labelField": "name"
						}
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "AuditStatementDetail",
						"primary": true
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "AuditStatementDetail",
			"route": "/audit-statements/:id",
			"type": "detail",
			"title": "Audit statement",
			"_note": "One audit committee statement. Verslag attached via FileService. Audit trail in a sidebar tab.",
			"config": {
				"register": "decidiq",
				"schema": "audit-statement",
				"_note": "Schema ref by slug (audit-statement), never PascalCase.",
				"widgets": [
					{
