					},
					{
						"id": "verklaring-related",
						"type": "related",
						"title": "Related",
						"icon": "LinkVariant"
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "verklaring-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 8,
