<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedVariablesAndParams="true"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="vendor/nextcloud/ocp/OCP/Capabilities/ICapability.php" preloadClasses="true" />
        <!--
            OpenRegister's data-access contract, which this app's lib/ typehints
            but does not own. OpenRegister supplies it at RUNTIME; these are
            analysis stubs only.

            hydra-gates used to make them resolvable by declaring
            `OCA\OpenRegister\Contract\` as a psr-4 prefix, which was a bug: that
            prefix is longer than openregister's own, so a vendored copy in ANY
            app defined the contract for the whole process (ConductionNL/.github#531).
            v1.9.0 removed it, and the runtime side is handled by the guarded
            require in tests/bootstrap-unit.php.

            Psalm never runs that bootstrap — it resolves types through the
            composer autoload map — so removing the prefix left 204 UndefinedClass
            errors here. A stub is the right seam: it teaches the analyser the
            shape without putting the class back into the runtime autoloader,
            which is what caused the original defect.
        -->
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/ObjectServiceInterface.php" />
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/ObjectEntityInterface.php" />

        <!--
            OpenRegister's AppHost composition-root entry point. `openregister`
            is a sibling Nextcloud app, not a composer dependency, so
            `OCA\OpenRegister\AppHost\Bootstrap` is genuinely absent here.

            Without it psalm cannot resolve the class named in
            `AppHostRegistrar::bindStoreController()`'s `class_exists()` guard,
            concludes the guarded block is dead, and reports
            `UnusedParam - Param context is never referenced in this method`
            about a parameter passed on the very next line.

            This replaces a `@psalm-suppress UnusedParam` on that method (#1145).
            A suppression silences the finding and also silences the next
            genuinely unused parameter in the same method; a stub answers the
            question psalm is asking and leaves the call type-checked.

            Shared, not vendored per app: filinq and planninq adopted the same
            route table and carry the same call.
        -->
        <file name="vendor/conduction/hydra-gates/hydra-gates/stubs/openregister-apphost-bootstrap.stub.php" />
    </stubs>
