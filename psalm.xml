<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    findUnusedVariablesAndParams="true"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="vendor/nextcloud/ocp/OCP/Capabilities/ICapability.php" preloadClasses="true" />
        <!--
            OpenRegister's data-access contract, which this app's lib/ typehints
            but does not own. OpenRegister supplies it at RUNTIME; these are
            analysis stubs only.

            hydra-gates used to make them resolvable by declaring
            `OCA\OpenRegister\Contract\` as a psr-4 prefix, which was a bug: that
            prefix is longer than openregister's own, so a vendored copy in ANY
            app defined the contract for the whole process (ConductionNL/.github#531).
            v1.9.0 removed it, and the runtime side is handled by the guarded
            require in tests/bootstrap-unit.php.

            Psalm never runs that bootstrap — it resolves types through the
            composer autoload map — so removing the prefix left 204 UndefinedClass
            errors here. A stub is the right seam: it teaches the analyser the
            shape without putting the class back into the runtime autoloader,
            which is what caused the original defect.
        -->
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/ObjectServiceInterface.php" />
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/ObjectEntityInterface.php" />

        <!--
            The register-slug resolver contract, for the same reason and through
            the same seam. A stub rather than a `referencedClass` suppression:
            the resolution is BRANCHED on, so psalm has to know that
            `RegisterSlugResolution::isResolved()` returns bool and that `->slug`
            is `?string`. Suppressing the class would leave both as mixed and
            quietly stop analysing the very branch this contract exists to force.

            Both files ship in conduction/hydra-gates v1.18.0 and later. v1.17.0
            and earlier carry only the two above, so they are listed here rather
            than assumed present.
        -->
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/RegisterSlugResolution.php" />
        <file name="vendor/conduction/hydra-gates/hydra-gates/contracts/RegisterSlugResolverInterface.php" />

        <!--
            OpenRegister's AppHost composition-root entry point. `openregister`
            is a sibling Nextcloud app, not a composer dependency, so
            `OCA\OpenRegister\AppHost\Bootstrap` is genuinely absent here.

            Without it psalm cannot resolve the class named in
            `AppHostRegistrar::bindStoreController()`'s `class_exists()` guard,
            concludes the guarded block is dead, and reports
            `UnusedParam - Param context is never referenced in this method`
            about a parameter passed on the very next line.

            This replaces a `@psalm-suppress UnusedParam` on that method (#1145).
            A suppression silences the finding and also silences the next
            genuinely unused parameter in the same method; a stub answers the
            question psalm is asking and leaves the call type-checked.

            Shared, not vendored per app: filinq and planninq adopted the same
            route table and carry the same call.
        -->
        <file name="vendor/conduction/hydra-gates/hydra-gates/stubs/openregister-apphost-bootstrap.stub.php" />
    </stubs>
    <issueHandlers>
        <!--
            WHAT IS SUPPRESSED, AND WHY. Measured 2026-09-11 (#1277 W1a).

            This block used to suppress 33 issue types for the whole of lib/
            and list 74 classes as undefined. Lifting all 33 produced 389
            errors: about 296 unused-code reports caused by DI wiring, and
            the rest real type and docblock problems, which were fixed in
            the same change. What remains below is only what is still
            needed, scoped as narrowly as psalm allows.

            Before widening any of these again, lift it in a scratch config
            and read what it hides. A global suppression silences the next
            real finding of that type as well as the one it was added for.
        -->

        <!--
            UNUSED-CODE REPORTS FROM DEPENDENCY INJECTION. Kept global.
            Nextcloud builds controllers from appinfo/routes.php, listeners
            and background jobs from registration calls, and services by
            autowiring. None of that is a PHP call site psalm can see, so
            nearly every class and public method in lib/ reads as unused
            (73 UnusedClass and 223 PossiblyUnusedMethod when lifted). Scoping
            these per file would mean listing most of lib/.
        -->
        <UnusedClass errorLevel="suppress"/>
        <PossiblyUnusedMethod errorLevel="suppress"/>

        <!--
            A RETURN VALUE NO CALLER READS. Report-worthy but not a type
            error; these methods return a value for their tests and for
            future callers. Scoped to the files that have one today.
        -->
        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress">
                <file name="lib/AppInfo/OpenRegisterAutoloader.php"/>
                <file name="lib/Service/NotificationPreferenceService.php"/>
                <file name="lib/Service/RegisterObjectStore.php"/>
                <file name="lib/Service/TranscriptionService.php"/>
            </errorLevel>
        </PossiblyUnusedReturnValue>

        <!--
            FALSE "UNUSED" REPORTS CAUSED BY A CLASS PSALM CANNOT RESOLVE.
            Each property or parameter below is used. Psalm stops analysing
            the code that uses it because that code names an OpenRegister
            class that exists only at runtime:
              - DecidiqToolProvider implements OpenRegister's IMcpToolProvider
                (MissingDependency), so psalm skips the class body and reports
                every constructor parameter and both tool properties unused.
                Loading tests/Stubs/Mcp/IMcpToolProvider.php as a stub was
                tried and does not change that.
              - OpenRegisterAutoloader passes $path to OC_App, which is
                server-private and absent from nextcloud/ocp.
        -->
        <MissingDependency>
            <errorLevel type="suppress">
                <file name="lib/AppInfo/Registrar/DomainServiceRegistrar.php"/>
            </errorLevel>
        </MissingDependency>
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <file name="lib/Mcp/DecidiqToolProvider.php"/>
            </errorLevel>
        </PossiblyUnusedParam>
        <UnusedProperty>
            <errorLevel type="suppress">
                <file name="lib/Mcp/DecidiqToolProvider.php"/>
            </errorLevel>
        </UnusedProperty>
        <UnusedVariable>
            <errorLevel type="suppress">
                <file name="lib/AppInfo/OpenRegisterAutoloader.php"/>
            </errorLevel>
        </UnusedVariable>

        <!--
            registerEventListener() is templated on the event class. Both
            calls below pass an OpenRegister event class, which psalm cannot
            resolve, so the template check fails on a class it has never seen.
        -->
        <InvalidArgument>
            <errorLevel type="suppress">
                <file name="lib/AppInfo/Registrar/IntegrationLeafRegistrar.php"/>
                <file name="lib/AppInfo/Registrar/PlatformIntegrationRegistrar.php"/>
            </errorLevel>
        </InvalidArgument>

        <!--
            array_values() after array_filter() is NOT redundant in these two
            files: array_filter() keeps keys, and the result is stored as a
            JSON list. Psalm infers the input as array<never, never> from an
            `$x['key'] ?? []` read on array<string, mixed>, and concludes the
            call does nothing.
        -->
        <RedundantFunctionCall>
            <errorLevel type="suppress">
                <file name="lib/Service/MotionCoauthorService.php"/>
                <file name="lib/Service/ProxyDelegationService.php"/>
            </errorLevel>
        </RedundantFunctionCall>

        <!--
            `(int)$e->getCode()` on a caught DomainException. Exception::$code
            is untyped, and a subclass may set a string code, so the cast is
            kept on purpose.
        -->
        <RedundantCast>
            <errorLevel type="suppress">
                <file name="lib/Controller/TranscriptionController.php"/>
            </errorLevel>
        </RedundantCast>

        <!--
            Classes named in docblocks that only exist at runtime.
        -->
        <UndefinedDocblockClass>
            <errorLevel type="suppress">
                <referencedClass name="OCA\OpenRegister\Service\ConfigurationService"/>
            </errorLevel>
        </UndefinedDocblockClass>

        <!--
            Classes referenced in code that only exist at runtime. Narrowed
            from 74 entries to the 19 that psalm actually reports: the other
            55 named OCP classes that nextcloud/ocp already defines, or
            OpenRegister and Guzzle classes this app no longer references.
        -->
        <UndefinedClass>
            <errorLevel type="suppress">
                <!-- Nextcloud's legacy bootstrap class. There is no OCP
                     interface for registering another app's autoloader, so the
                     ADR-040 AppHost prelude in AppInfo\OpenRegisterAutoloader
                     has to call OC_App::registerAutoloading() directly. It is
                     server-private and therefore absent from nextcloud/ocp. -->
                <referencedClass name="OC_App"/>
                <!-- OpenRegister cross-app classes (loaded at runtime). -->
                <referencedClass name="OCA\OpenRegister\AppHost\Listener\GenericDeepLinkRegistrationListener"/>
                <referencedClass name="OCA\OpenRegister\Db\AuditTrail"/>
                <referencedClass name="OCA\OpenRegister\Db\AuditTrailMapper"/>
                <referencedClass name="OCA\OpenRegister\Db\ObjectEntity"/>
                <referencedClass name="OCA\OpenRegister\Db\RegisterMapper"/>
                <referencedClass name="OCA\OpenRegister\Db\SchemaMapper"/>
                <referencedClass name="OCA\OpenRegister\Event\DeepLinkRegistrationEvent"/>
                <referencedClass name="OCA\OpenRegister\Event\ObjectCreatedEvent"/>
                <referencedClass name="OCA\OpenRegister\Event\ObjectCreatingEvent"/>
                <referencedClass name="OCA\OpenRegister\Event\ObjectDeletedEvent"/>
                <referencedClass name="OCA\OpenRegister\Event\ObjectUpdatedEvent"/>
                <!-- ADR-066 sibling-app leaf registration (RegisterDecisionsLeafListener). -->
                <referencedClass name="OCA\OpenRegister\Event\RegisterLeafProvidersEvent"/>
                <referencedClass name="OCA\OpenRegister\Service\Integration\LeafDescriptor"/>
                <referencedClass name="OCA\OpenRegister\Mcp\IMcpToolProvider"/>
                <referencedClass name="OCA\OpenRegister\Service\AuditHashService"/>
                <referencedClass name="OCA\OpenRegister\Service\CalendarEventService"/>
                <referencedClass name="OCA\OpenRegister\Service\FileService"/>
                <referencedClass name="OCA\OpenRegister\Service\TaskService"/>
            </errorLevel>
        </UndefinedClass>
    </issueHandlers>
    <extraFiles>
        <directory name="vendor/nextcloud/ocp" />
    </extraFiles>
</psalm>
